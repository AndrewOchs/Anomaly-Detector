# Application Settings
APP_NAME=Anomaly Detection Platform
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
DATABASE_URL=postgresql://anomaly_user:anomaly_password@localhost:5432/anomaly_detector
DB_ECHO=False

# PostgreSQL Specific (if not using DATABASE_URL)
POSTGRES_USER=anomaly_user
POSTGRES_PASSWORD=anomaly_password
POSTGRES_DB=anomaly_detector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# API Keys - External Services
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key-here
OPENWEATHER_API_KEY=your-openweather-api-key-here
COINGECKO_API_KEY=your-coingecko-api-key-here

# File Upload Settings
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=csv,xlsx,xls
UPLOAD_FOLDER=./uploads

# CORS Settings (for API)
CORS_ORIGINS=http://localhost:8050,http://localhost:8000

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
DASH_HOST=0.0.0.0
DASH_PORT=8050

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Cache Settings
CACHE_TTL_SECONDS=300
